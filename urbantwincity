/* ---------- 관찰 카메라 ---------- */

let yaw=.65;
let pitch=.65;
let distance=330;

let dragging=false;
let lastX=0;
let lastY=0;


function observeCamera(){

  const x=
    Math.sin(yaw)*
    Math.cos(pitch)*
    distance;

  const y=
    Math.sin(pitch)*
    distance;

  const z=
    Math.cos(yaw)*
    Math.cos(pitch)*
    distance;


  camera.position.set(
    x,
    y,
    z
  );


  camera.lookAt(
    0,
    20,
    0
  );
}


canvas.addEventListener(
  "pointerdown",
  e=>{

    if(mode!=="observe")return;

    dragging=true;

    lastX=e.clientX;
    lastY=e.clientY;
  }
);


window.addEventListener(
  "pointerup",
  ()=>{
    dragging=false;
  }
);


window.addEventListener(
  "pointermove",
  e=>{

    if(
      !dragging||
      mode!=="observe"
    )return;


    yaw+=
      (e.clientX-lastX)*
      .006;


    pitch+=
      (e.clientY-lastY)*
      .006;


    pitch=
      Math.max(
        .22,
        Math.min(
          1.4,
          pitch
        )
      );


    lastX=e.clientX;
    lastY=e.clientY;


    observeCamera();
  }
);


canvas.addEventListener(
  "wheel",
  e=>{

    if(mode!=="observe")return;

    distance+=
      e.deltaY*.2;


    distance=
      Math.max(
        80,
        Math.min(
          600,
          distance
        )
      );


    observeCamera();
  }
);


