document.getElementById(
  "run"
)
.addEventListener(
  "click",
  ()=>{

    if(running)return;

    running=true;


    const timer=
      setInterval(
        ()=>{

          advance(1);

          if(
            state.year>=2046
          ){

            clearInterval(timer);
            running=false;
          }

        },
        180
      );
  }
);


document.getElementById(
  "reset"
)
.addEventListener(
  "click",
  ()=>{

    state.year=2026;

    document.getElementById(
      "year"
    ).textContent="2026";

