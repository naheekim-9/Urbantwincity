/* ---------- 리사이즈 ---------- */

function resize(){

  const w=
    canvas.clientWidth;

  const h=
    canvas.clientHeight;


  if(!w||!h)return;


  camera.aspect=
    w/h;

  camera.updateProjectionMatrix();


  renderer.setSize(
    w,
    h,
    false
  );
}


window.addEventListener(
  "resize",
  resize
);


/* ---------- 시작 ---------- */

function start(){

  resize();


  const loadingBar=
    document.getElementById(
      "bar"
    );


  loadingBar.style.width="20%";


  generateCity();


  loadingBar.style.width="65%";


  metrics();


  observeCamera();


  loadingBar.style.width="100%";


  setTimeout(
    ()=>{
      document.getElementById(
        "loading"
      ).style.display=
        "none";
    },
    350
  );


  animate();
}


/* ---------- 렌더링 ---------- */

function animate(){

  requestAnimationFrame(
    animate
  );


  walkUpdate();


  renderer.render(
    scene,
    camera
  );
}


/* ---------- 실행 오류 표시 ---------- */

window.addEventListener(
  "error",
  e=>{

    const loading=
      document.getElementById(
        "loading"
      );

    if(
      loading.style.display!=="none"
    ){

      document.getElementById(
        "loadingText"
      ).textContent=
        "오류: "+
        e.message;
    }
  }
);


try{

  start();

}catch(error){

  document.getElementById(
    "loadingText"
  ).textContent=
    "도시 생성 오류: "+
    error.message;

  console.error(error);
}

