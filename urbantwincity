<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Urban Twin — 2차 공공기관 이전</title>

<style>
*{box-sizing:border-box}
html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"Noto Sans KR",sans-serif;
  background:#dfe7eb;
  color:#17232b;
}
button,input,select{font:inherit}

#app{
  width:100%;
  height:100%;
  position:relative;
}

#canvas{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  display:block;
}

#hud{
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 20px;
  background:rgba(255,255,255,.92);
  border-bottom:1px solid rgba(0,0,0,.08);
  z-index:10;
}

.logo{
  font-size:19px;
  font-weight:900;
  letter-spacing:.08em;
}

.logo small{
  display:block;
  margin-top:2px;
  font-size:10px;
  letter-spacing:.02em;
  color:#73808a;
}

#yearBox{
  text-align:right;
}

#year{
  font-size:28px;
  font-weight:900;
}

#yearBox span{
  font-size:11px;
  color:#7c8790;
}

#side{
  position:absolute;
  right:16px;
  top:84px;
  width:310px;
  max-height:calc(100% - 100px);
  overflow:auto;
  background:rgba(255,255,255,.95);
  border:1px solid rgba(0,0,0,.08);
  border-radius:16px;
  padding:16px;
  z-index:20;
  box-shadow:0 12px 40px rgba(0,0,0,.13);
}

.section{
  font-size:12px;
  font-weight:900;
  margin:4px 0 12px;
  letter-spacing:.03em;
}

.control{
  margin-bottom:13px;
}

.controlTop{
  display:flex;
  justify-content:space-between;
  font-size:11px;
  font-weight:700;
  margin-bottom:6px;
}

.controlTop b{
  font-size:11px;
}

input[type=range]{
  width:100%;
  accent-color:#385d70;
}

select{
  width:100%;
  height:42px;
  border:1px solid #d4dce1;
  border-radius:9px;
  background:#fff;
  padding:0 10px;
  margin-bottom:9px;
}

hr{
  border:0;
  border-top:1px solid #e4e9ec;
  margin:17px 0;
}

.metrics{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}

.metric{
  padding:10px;
  background:#f3f6f7;
  border-radius:9px;
}

.metric span{
  display:block;
  font-size:9px;
  color:#75818a;
  margin-bottom:3px;
}

.metric strong{
  font-size:15px;
}

.actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}

button{
  min-height:43px;
  border:0;
  border-radius:9px;
  background:#263943;
  color:white;
  font-size:11px;
  font-weight:800;
  cursor:pointer;
}

button.secondary{
  background:#edf1f3;
  color:#27353d;
}

button:active{
  transform:scale(.98);
}

#info{
  display:none;
  position:absolute;
  left:18px;
  bottom:18px;
  width:300px;
  background:rgba(255,255,255,.96);
  border-radius:14px;
  padding:16px;
  z-index:30;
  box-shadow:0 10px 35px rgba(0,0,0,.16);
}

#info h2{
  margin:0 25px 5px 0;
  font-size:17px;
}

#info p{
  margin:0 0 12px;
  color:#71808a;
  font-size:11px;
}

.infoRow{
  display:flex;
  justify-content:space-between;
  border-top:1px solid #edf0f1;
  padding:8px 0;
  font-size:11px;
}

#close{
  position:absolute;
  right:7px;
  top:7px;
  width:35px;
  height:35px;
  min-height:35px;
  border-radius:50%;
  background:transparent;
  color:#333;
  font-size:18px;
}

#mode{
  position:absolute;
  left:18px;
  top:84px;
  z-index:15;
  display:flex;
  gap:7px;
}

#mode button{
  box-shadow:0 4px 15px rgba(0,0,0,.15);
}

#hint{
  position:absolute;
  left:50%;
  bottom:18px;
  transform:translateX(-50%);
  background:rgba(20,30,35,.78);
  color:white;
  border-radius:20px;
  padding:8px 13px;
  font-size:10px;
  z-index:15;
  pointer-events:none;
  white-space:nowrap;
}

#joystick{
  display:none;
  position:absolute;
  left:25px;
  bottom:55px;
  width:125px;
  height:125px;
  border-radius:50%;
  background:rgba(255,255,255,.25);
  border:1px solid rgba(255,255,255,.5);
  z-index:40;
  touch-action:none;
}

#stick{
  position:absolute;
  width:50px;
  height:50px;
  left:37px;
  top:37px;
  border-radius:50%;
  background:rgba(255,255,255,.9);
  box-shadow:0 3px 15px rgba(0,0,0,.2);
}

#loading{
  position:absolute;
  inset:0;
  z-index:100;
  background:#e7edf0;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
}

#loading strong{
  font-size:25px;
  letter-spacing:.1em;
}

#loading p{
  color:#71808a;
  font-size:11px;
}

.bar{
  width:220px;
  height:4px;
  background:#cdd6db;
  border-radius:4px;
  overflow:hidden;
}

#bar{
  width:0%;
  height:100%;
  background:#314b59;
}

@media(max-width:800px){

  #hud{
    height:58px;
    padding:0 13px;
  }

  .logo{
    font-size:15px;
  }

  #year{
    font-size:22px;
  }

  #side{
    left:10px;
    right:10px;
    top:auto;
    bottom:10px;
    width:auto;
    max-height:39%;
    border-radius:14px;
  }

  #mode{
    top:68px;
    left:10px;
  }

  #info{
    left:10px;
    bottom:43%;
    width:calc(100% - 20px);
  }

  #hint{
    bottom:42%;
  }
}
</style>
</head>

<body>

<div id="app">

<canvas id="canvas"></canvas>

<header id="hud">
  <div>
    <div class="logo">URBAN TWIN</div>
    <div class="logo">
      2차 공공기관 이전 · 가상도시 실험
    </div>
  </div>

  <div id="yearBox">
    <div id="year">2026</div>
    <span>SIMULATION YEAR</span>
  </div>
</header>

<div id="mode">
  <button id="observe">도시 관찰</button>
  <button id="walk">🚶 도시 진입</button>
</div>

<aside id="side">

  <div class="section">도시 설계 변수</div>

  <div class="control">
    <div class="controlTop">
      <span>공공기관 집중도</span>
      <b id="vPublic">70</b>
    </div>
    <input id="public" type="range" min="0" max="100" value="70">
  </div>

  <div class="control">
    <div class="controlTop">
      <span>산업 연계도</span>
      <b id="vIndustry">65</b>
    </div>
    <input id="industry" type="range" min="0" max="100" value="65">
  </div>

  <div class="control">
    <div class="controlTop">
      <span>대학·연구 역량</span>
      <b id="vResearch">60</b>
    </div>
    <input id="research" type="range" min="0" max="100" value="60">
  </div>

  <div class="control">
    <div class="controlTop">
      <span>정주 환경</span>
      <b id="vSettlement">55</b>
    </div>
    <input id="settlement" type="range" min="0" max="100" value="55">
  </div>

  <div class="control">
    <div class="controlTop">
      <span>광역교통 접근성</span>
      <b id="vTransport">60</b>
    </div>
    <input id="transport" type="range" min="0" max="100" value="60">
  </div>

  <hr>

  <div class="section">도시 공간 구조</div>

  <select id="structure">
    <option value="poly">다핵형 — 공공·산업·대학 분산</option>
    <option value="compact">압축형 — 핵심시설 집중</option>
    <option value="linear">선형형 — 교통축 중심</option>
    <option value="mixed">혼합형 — 복합 도시</option>
  </select>

  <select id="scenario">
    <option value="optimal">통합 최적 시나리오</option>
    <option value="industry">산업 클러스터 강화</option>
    <option value="settlement">정주 환경 강화</option>
    <option value="talent">지역인재 강화</option>
    <option value="first">1차 이전 방식 비교</option>
  </select>

  <hr>

  <div class="section">시뮬레이션</div>

  <div class="actions">
    <button id="year1">+1년</button>
    <button id="year5">+5년</button>
    <button id="run">▶ 2046년까지</button>
    <button id="reset" class="secondary">2026 초기화</button>
  </div>

  <hr>

  <div class="section">도시 성과</div>

  <div class="metrics">

    <div class="metric">
      <span>인구</span>
      <strong id="population">80,000</strong>
    </div>

    <div class="metric">
      <span>입주 기업</span>
      <strong id="firms">1,200</strong>
    </div>

    <div class="metric">
      <span>일자리</span>
      <strong id="jobs">42,000</strong>
    </div>

    <div class="metric">
      <span>상권 활성도</span>
      <strong id="commerce">52%</strong>
    </div>

    <div class="metric">
      <span>상업 공실률</span>
      <strong id="vacancy">38%</strong>
    </div>

    <div class="metric">
      <span>정주 안정성</span>
      <strong id="stability">55%</strong>
    </div>

    <div class="metric">
      <span>산학연 연계</span>
      <strong id="linkage">61%</strong>
    </div>

    <div class="metric">
      <span>종합 도시지수</span>
      <strong id="index">57</strong>
    </div>

  </div>

</aside>

<div id="info">
  <button id="close">×</button>

  <h2 id="infoName">시설</h2>
  <p id="infoDesc">도시 시설 정보</p>

  <div class="infoRow">
    <span>시설 유형</span>
    <b id="infoType">-</b>
  </div>

  <div class="infoRow">
    <span>건물 규모</span>
    <b id="infoHeight">-</b>
  </div>

  <div class="infoRow">
    <span>지역 연계도</span>
    <b id="infoLink">-</b>
  </div>
</div>

<div id="joystick">
  <div id="stick"></div>
</div>

<div id="hint">
  관찰 모드: 드래그로 도시를 둘러보세요 · 건물을 탭하면 정보가 표시됩니다.
</div>

<div id="loading">
  <strong>URBAN TWIN</strong>
  <p id="loadingText">가상도시를 구축하는 중...</p>
  <div class="bar"><div id="bar"></div></div>
</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.min.js"></script>

<script>

/* =========================================================
   URBAN TWIN
   2차 공공기관 이전 가상도시 시뮬레이션
========================================================= */

"use strict";


/* ---------- 기본 ---------- */

const canvas =
  document.getElementById("canvas");

const scene =
  new THREE.Scene();

scene.background =
  new THREE.Color(0xb9cbd3);

scene.fog =
  new THREE.Fog(
    0xb9cbd3,
    260,
    850
  );


const camera =
  new THREE.PerspectiveCamera(
    55,
    1,
    .1,
    1500
  );


const renderer =
  new THREE.WebGLRenderer({
    canvas,
    antialias:true,
    powerPreference:"high-performance"
  });

renderer.setPixelRatio(
  Math.min(
    window.devicePixelRatio || 1,
    1.7
  )
);

renderer.shadowMap.enabled=true;

renderer.shadowMap.type =
  THREE.PCFSoftShadowMap;


/* ---------- 조명 ---------- */

const sky =
  new THREE.HemisphereLight(
    0xeef8ff,
    0x596b60,
    2.2
  );

scene.add(sky);


const sun =
  new THREE.DirectionalLight(
    0xfff4dc,
    3.5
  );

sun.position.set(
  -180,
  260,
  150
);

sun.castShadow=true;

sun.shadow.mapSize.width=2048;
sun.shadow.mapSize.height=2048;

sun.shadow.camera.left=-400;
sun.shadow.camera.right=400;
sun.shadow.camera.top=400;
sun.shadow.camera.bottom=-400;

scene.add(sun);


/* ---------- 도시 ---------- */

const city =
  new THREE.Group();

scene.add(city);


const clickable=[];

let mode="observe";

let selected=null;


/* ---------- 상태 ---------- */

const state={

  year:2026,

  public:70,

  industry:65,

  research:60,

  settlement:55,

  transport:60,

  structure:"poly",

  scenario:"optimal"
};


/* ---------- 재질 ---------- */

const mat={

  ground:new THREE.MeshStandardMaterial({
    color:0x789477,
    roughness:1
  }),

  road:new THREE.MeshStandardMaterial({
    color:0x363d42,
    roughness:.95
  }),

  sidewalk:new THREE.MeshStandardMaterial({
    color:0xc9ced0,
    roughness:.9
  }),

  public:new THREE.MeshStandardMaterial({
    color:0x637d8b,
    roughness:.45,
    metalness:.15
  }),

  office:new THREE.MeshStandardMaterial({
    color:0x8f9ca3,
    roughness:.45,
    metalness:.15
  }),

  glass:new THREE.MeshStandardMaterial({
    color:0x668f9c,
    roughness:.15,
    metalness:.4
  }),

  residential:new THREE.MeshStandardMaterial({
    color:0xc6b8a5,
    roughness:.72
  }),

  commercial:new THREE.MeshStandardMaterial({
    color:0xb79e79,
    roughness:.65
  }),

  university:new THREE.MeshStandardMaterial({
    color:0x8d947c,
    roughness:.7
  }),

  research:new THREE.MeshStandardMaterial({
    color:0x6f8996,
    roughness:.4,
    metalness:.2
  }),

  white:new THREE.MeshStandardMaterial({
    color:0xe4e7e7,
    roughness:.8
  }),

  dark:new THREE.MeshStandardMaterial({
    color:0x273239,
    roughness:.55
  }),

  green:new THREE.MeshStandardMaterial({
    color:0x527756,
    roughness:1
  })
};


/* ---------- 도형 ---------- */

function box(
  w,h,d,
  material,
  x=0,
  y=0,
  z=0
){

  const m =
    new THREE.Mesh(
      new THREE.BoxGeometry(
        w,h,d
      ),
      material
    );

  m.position.set(
    x,y,z
  );

  m.castShadow=true;
  m.receiveShadow=true;

  return m;
}


/* ---------- 건물 ---------- */

function building(options){

  const {
    x,
    z,
    w,
    d,
    h,
    type,
    name
  }=options;

  const g =
    new THREE.Group();


  /* 본체 */

  const body =
    box(
      w,
      h,
      d,
      mat[type] || mat.office,
      0,
      h/2,
      0
    );

  g.add(body);


  /* 저층부 */

  const podium =
    box(
      w*1.08,
      Math.min(5,h*.18),
      d*1.08,
      mat.white,
      0,
      Math.min(5,h*.18)/2,
      0
    );

  g.add(podium);


  /* 창문 */

  const windowMat =
    mat.glass;

  const floors =
    Math.max(
      2,
      Math.floor(h/4)
    );

  const cols =
    Math.max(
      2,
      Math.floor(w/3.7)
    );


  for(
    let floor=0;
    floor<floors;
    floor++
  ){

    const yy =
      4+
      floor*
      ((h-5)/floors);

    for(
      let c=0;
      c<cols;
      c++
    ){

      const xx =
        -w/2+
        2+
        c*
        ((w-4)/
        Math.max(
          1,
          cols-1
        ));

      const win =
        box(
          1.25,
          1.45,
          .09,
          windowMat,
          xx,
          yy,
          d/2+.06
        );

      g.add(win);


      /* 반대편 */

      const win2 =
        win.clone();

      win2.position.z =
        -d/2-.06;

      g.add(win2);
    }
  }


  /* 측면 세로 유리 */

  if(w>14){

    const strip =
      box(
        .7,
        h*.8,
        d*.72,
        mat.glass,
        w/2+.06,
        h*.48,
        0
      );

    g.add(strip);

    const strip2 =
      strip.clone();

    strip2.position.x =
      -w/2-.06;

    g.add(strip2);
  }


  /* 옥상 */

  const roof =
    box(
      w*.72,
      1.3,
      d*.65,
      mat.dark,
      0,
      h+.65,
      0
    );

  g.add(roof);


  /* 옥상 설비 */

  if(h>25){

    for(
      let i=0;
      i<3;
      i++
    ){

      const unit =
        box(
          2.2,
          1.3,
          2.2,
          mat.white,
          -w*.25+
          i*2.8,
          h+1.95,
          0
        );

      g.add(unit);
    }
  }


  /* 입구 */

  const entrance =
    box(
      Math.min(5,w*.35),
      3.5,
      .25,
      mat.dark,
      0,
      1.75,
      d/2+.18
    );

  g.add(entrance);


  g.position.set(
    x,
    0,
    z
  );


  g.userData={
    name,
    type,
    height:h,
    linkage:
      Math.round(
        (
          state.industry+
          state.research+
          state.public
        )/3
      )
  };


  body.userData=
    g.userData;

  clickable.push(body);

  return g;
}


/* ---------- 도로 ---------- */

function road(
  x,z,w,d
){

  const r =
    box(
      w,
      .15,
      d,
      mat.road,
      x,
      .075,
      z
    );

  city.add(r);


  /* 차선 */

  const horizontal =
    w>d;

  const length =
    horizontal?w:d;


  for(
    let i=-length/2+8;
    i<length/2;
    i+=11
  ){

    const line =
      horizontal

      ? box(
          5,.035,.15,
          mat.white,
          x+i,
          .17,
          z
        )

      : box(
          .15,.035,5,
          mat.white,
          x,
          .17,
          z+i
        );

    city.add(line);
  }


  /* 보도 */

  if(horizontal){

    city.add(
      box(
        w,
        .25,
        3,
        mat.sidewalk,
        x,
        .12,
        z+d/2+2
      )
    );

    city.add(
      box(
        w,
        .25,
        3,
        mat.sidewalk,
        x,
        .12,
        z-d/2-2
      )
    );

  }else{

    city.add(
      box(
        3,
        .25,
        d,
        mat.sidewalk,
        x+w/2+2,
        .12,
        z
      )
    );

    city.add(
      box(
        3,
        .25,
        d,
        mat.sidewalk,
        x-w/2-2,
        .12,
        z
      )
    );
  }
}


/* ---------- 나무 ---------- */

function tree(x,z){

  const g =
    new THREE.Group();

  const trunk =
    new THREE.Mesh(
      new THREE.CylinderGeometry(
        .25,.35,3.2,8
      ),
      new THREE.MeshStandardMaterial({
        color:0x69503a
      })
    );

  trunk.position.y=1.6;

  g.add(trunk);


  const crown =
    new THREE.Mesh(
      new THREE.SphereGeometry(
        2.3,
        10,
        8
      ),
      mat.green
    );

  crown.position.y=4.1;

  crown.castShadow=true;

  g.add(crown);


  g.position.set(
    x,0,z
  );

  city.add(g);
}


/* ---------- 차량 ---------- */

function car(x,z,rotation=0){

  const g =
    new THREE.Group();

  const body =
    box(
      4.5,
      1,
      2,
      mat.dark,
      0,
      1,
      0
    );

  g.add(body);


  const cabin =
    box(
      2.5,
      .9,
      1.65,
      mat.glass,
      -.15,
      1.85,
      0
    );

  g.add(cabin);


  const wheelMat =
    new THREE.MeshStandardMaterial({
      color:0x171a1c,
      roughness:1
    });


  for(
    const wx of [-1.5,1.5]
  ){

    for(
      const wz of [-1,1]
    ){

      const wheel =
        new THREE.Mesh(
          new THREE.CylinderGeometry(
            .38,.38,.35,12
          ),
          wheelMat
        );

      wheel.rotation.z=
        Math.PI/2;

      wheel.position.set(
        wx,
        .55,
        wz
      );

      g.add(wheel);
    }
  }


  g.position.set(
    x,.2,z
  );

  g.rotation.y=
    rotation;

  city.add(g);
}


