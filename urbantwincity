/* ---------- 도시 생성 ---------- */

function generateCity(){

  while(
    city.children.length
  ){

    city.remove(
      city.children[0]
    );
  }

  clickable.length=0;


  /* 지형 */

  const ground =
    new THREE.Mesh(
      new THREE.PlaneGeometry(
        900,900
      ),
      mat.ground
    );

  ground.rotation.x=
    -Math.PI/2;

  ground.receiveShadow=true;

  city.add(ground);


  /* 주요 교통축 */

  road(
    0,0,
    700,28
  );

  road(
    0,0,
    28,700
  );

  road(
    0,150,
    700,18
  );

  road(
    150,0,
    18,700
  );


  /* 보조도로 */

  road(
    -130,0,
    500,12
  );

  road(
    0,-130,
    12,500
  );


  /* 교통센터 */

  transitHub(
    0,
    0
  );


  /* 중앙 공원 */

  park(
    0,
    65,
    55,
    42
  );


  /* 공공기관 */

  const publicCount =
    5+
    Math.floor(
      state.public/18
    );


  for(
    let i=0;
    i<publicCount;
    i++
  ){

    let angle =
      i/publicCount*
      Math.PI*2;

    let radius =
      state.structure==="compact"
      ? 42
      : 70;

    if(
      state.structure==="linear"
    ){

      angle =
        Math.PI+
        i/publicCount*
        Math.PI;
    }


    const x =
      Math.cos(angle)*
      radius;

    const z =
      Math.sin(angle)*
      radius;


    const b =
      building({

        x,
        z,

        w:
          20+
          state.public*.09,

        d:
          18,

        h:
          30+
          state.public*.45,

        type:"public",

        name:
          "공공기관 업무센터 "+
          (i+1)
      });

    city.add(b);
  }


  /* 대학 */

  const universityCount =
    3+
    Math.floor(
      state.research/30
    );


  for(
    let i=0;
    i<universityCount;
    i++
  ){

    const x =
      -150+
      (i%3)*55;

    const z =
      150+
      Math.floor(i/3)*48;


    const b =
      building({

        x,z,

        w:28,

        d:24,

        h:
          16+
          state.research*.2,

        type:"university",

        name:
          "지역대학 캠퍼스 "+
          (i+1)
      });

    city.add(b);
  }


  /* R&D */

  const researchCount =
    5+
    Math.floor(
      state.research/15
    );


  for(
    let i=0;
    i<researchCount;
    i++
  ){

    const x =
      -130+
      (i%5)*38;

    const z =
      100+
      Math.floor(i/5)*38;


    const b =
      building({

        x,z,

        w:
          18+
          state.research*.08,

        d:20,

        h:
          20+
          state.research*.3,

        type:"research",

        name:
          "R&D 연구소 "+
          (i+1)
      });

    city.add(b);
  }


  /* 산업 */

  const companyCount =
    10+
    Math.floor(
      state.industry/7
    );


  for(
    let i=0;
    i<companyCount;
    i++
  ){

    const x =
      100+
      (i%6)*38;

    const z =
      -80-
      Math.floor(i/6)*42;


    const b =
      building({

        x,z,

        w:
          22+
          state.industry*.08,

        d:25,

        h:
          13+
          state.industry*.22,

        type:"office",

        name:
          "연계기업·산업센터 "+
          (i+1)
      });

    city.add(b);
  }


  /* 주거 */

  const residentialCount =
    26+
    Math.floor(
      state.settlement/5
    );


  for(
    let i=0;
    i<residentialCount;
    i++
  ){

    let x =
      -250+
      (i%9)*55;

    let z =
      -235+
      Math.floor(i/9)*50;


    if(
      state.structure==="compact"
    ){

      x =
        -180+
        (i%8)*48;

      z =
        -180+
        Math.floor(i/8)*45;
    }


    const b =
      building({

        x,z,

        w:22,

        d:22,

        h:
          22+
          state.settlement*.35,

        type:"residential",

        name:"정주 주거단지"
      });

    city.add(b);
  }


  /* 상업 */

  const shops =
    14+
    Math.floor(
      (
        state.settlement+
        state.transport
      )/20
    );


  for(
    let i=0;
    i<shops;
    i++
  ){

    const x =
      -100+
      (i%7)*30;

    const z =
      -25+
      Math.floor(i/7)*32;


    const b =
      building({

        x,z,

        w:15,

        d:15,

        h:
          9+
          state.settlement*.1,

        type:"commercial",

        name:"지역 상업시설"
      });

    city.add(b);
  }


  /* 공원 */

  park(
    -185,
    -30,
    55,
    35
  );

  park(
    185,
    80,
    48,
    38
  );


  /* 차량 */

  for(
    let i=-250;
    i<=250;
    i+=35
  ){

    car(
      i,
      5,
      0
    );
  }


  for(
    let i=-230;
    i<=230;
    i+=42
  ){

    car(
      5,
      i,
      Math.PI/2
    );
  }


  /* 가로수 */

  for(
    let i=-300;
    i<=300;
    i+=28
  ){

    tree(
      i,
      23
    );

    tree(
      i,
      -23
    );
  }
}


/* ---------- 지표 ---------- */

function metrics(){

  const years =
    state.year-2026;


  const structural =
    (
      state.public+
      state.industry+
      state.research+
      state.settlement+
      state.transport
    )/5;


  let growth =
    1+
    structural/500+
    years*
    (
      .006+
      structural/18000
    );


  if(
    state.scenario==="first"
  ){

    growth*=.91;
  }


  const population =
    Math.round(
      80000*growth
    );


  const firms =
    Math.round(
      1200*
      (
        1+
        state.industry/170+
        state.research/320+
        years*.009
      )
    );


  const jobs =
    Math.round(
      42000*
      (
        1+
        state.public/350+
        state.industry/260+
        years*.008
      )
    );


  const commerce =
    Math.min(
      99,
      Math.round(
        20+
        state.settlement*.28+
        state.transport*.24+
        state.industry*.18
      )
    );


  const vacancy =
    Math.max(
      5,
      Math.round(
        58-
        state.settlement*.19-
        state.transport*.13-
        state.industry*.08
      )
    );


  const stability =
    Math.min(
      99,
      Math.round(
        state.settlement*.48+
        state.transport*.27+
        state.research*.1
      )
    );


  const linkage =
    Math.round(
      (
        state.industry+
        state.research+
        state.public
      )/3
    );


  const index =
    Math.round(
      (
        commerce+
        stability+
        linkage+
        (100-vacancy)+
        structural
      )/5
    );


  document.getElementById(
    "population"
  ).textContent=
    population.toLocaleString();


  document.getElementById(
    "firms"
  ).textContent=
    firms.toLocaleString();


  document.getElementById(
    "jobs"
  ).textContent=
    jobs.toLocaleString();


  document.getElementById(
    "commerce"
  ).textContent=
    commerce+"%";


  document.getElementById(
    "vacancy"
  ).textContent=
    vacancy+"%";


  document.getElementById(
    "stability"
  ).textContent=
    stability+"%";


  document.getElementById(
    "linkage"
  ).textContent=
    linkage+"%";


  document.getElementById(
    "index"
  ).textContent=
    index;
}


